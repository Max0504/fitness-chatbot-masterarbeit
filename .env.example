# Google Gemini API (Free Tier - kostenlos, kein Kreditkarteneintrag nötig)
# Hol dir einen Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_KEY_HERE

# LLM-Modell (austauschbar)
LLM_MODEL=models/gemini-2.5-flash-lite

# Datenbank (relativ zum Projekt-Root)
DATABASE_URL=sqlite:///./data/fitness.db
